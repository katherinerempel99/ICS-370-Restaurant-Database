
# Restaurant Management - Django Configuration
# Copy this file to .env and fill in your own credentials.

DJANGO_SECRET_KEY=replace-with-your-own-generated-secret-key

# Azure SQL Database
DB_HOST=ics370-restaurant-database.database.windows.net
DB_NAME=RestaurantDB
DB_PORT=1433
DB_USER=your-database-username
DB_PASSWORD=your-database-password
